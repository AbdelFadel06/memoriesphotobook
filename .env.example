# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres
POSTGRES_DB=photobook
POSTGRES_USER=photobook
POSTGRES_PASSWORD=photobook
DATABASE_URL=postgres://photobook:photobook@postgres:5432/photobook

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (RustFS locally, R2/B2 in prod)
S3_ENDPOINT_URL=http://storage:9000
# Endpoint reachable by the browser, used to sign upload/download URLs
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=photobook
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Used by the PDF worker to render pages with the frontend's /print route
FRONTEND_INTERNAL_URL=http://frontend:3000

# Errors
SENTRY_DSN=
